# Copy to .env and fill in your OpenAI-compatible chat endpoint.
LLM_MODEL_ID=
LLM_API_KEY=
LLM_BASE_URL=

# Needed only when enabling Cohere reranking.
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v5.0-fast

# Optional USD rates per million tokens for the usage estimate.
# Export these variables in your shell; the runtime cost calculator reads the environment.
# LLM_INPUT_COST_PER_1M=
# LLM_OUTPUT_COST_PER_1M=
